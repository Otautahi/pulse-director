# Copy this to .env; real .env is ignored by Git.
# REQUIRED: Wi-Fi IP of the phone with Lovense Remote Game Mode.
PULSEDIRECTOR_PHONE_IP=
# Localhost-only by default. For home LAN access, put the Docker HOST's
# trusted LAN IP here, NOT the phone's IP. Never use 0.0.0.0 or public IP.
PULSEDIRECTOR_HOST_BIND_IP=127.0.0.1
PULSEDIRECTOR_HOST_PORT=8765
